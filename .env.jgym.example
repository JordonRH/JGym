# Copy to .env. Set these to your final Cloudflare hostname BEFORE creating passkeys.
RP_ID=gym.example.com
ORIGIN=https://gym.example.com
RP_NAME=JGym
WEB_PORT=8080
FIRST_USER_ADMIN=1
PASSWORD_LOGIN=1
ALLOW_GUEST=0
# Bootstrap: keep the hostname private until you register your own admin account.
# Then set INVITE_ONLY=1 and restart the API before sharing the address.
INVITE_ONLY=0
DEFAULT_LANG=en
# Only needed for the optional bundled cloudflared service. Never commit this value.
TUNNEL_TOKEN=
